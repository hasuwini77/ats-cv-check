{
  "name": "ats-cv-check",
  "version": "0.1.0",
  "description": "Deterministic ATS-style CV checker. No AI, no network, runs locally. English, Swedish and French.",
  "license": "MIT",
  "author": "Edwin Andermyr",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20.10" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-demo.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "locales": "node scripts/extract-locales.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
