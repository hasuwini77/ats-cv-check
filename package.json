{
  "name": "ats-cv-check",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic ATS-style CV checker. No AI, no network, runs locally. English, Swedish and French.",
  "license": "MIT",
  "author": "Edwin Andermyr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasuwini77/ats-cv-check.git"
  },
  "homepage": "https://github.com/hasuwini77/ats-cv-check#readme",
  "bugs": {
    "url": "https://github.com/hasuwini77/ats-cv-check/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-demo.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "locales": "node scripts/extract-locales.mjs",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
